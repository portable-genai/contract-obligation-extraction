__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/
.venv/
venv/

# Environment files. The *.example files ARE committed; the real ones never are.
.env
.env.*
!.env.example
!.env.secrets.example

# Local stores and credentials
*.db
*.pem
*.key
*-key.json
service-account*.json
application_default_credentials.json

# Node / Next.js (the `ui/` micro-frontend)
node_modules/
.next/
*.tsbuildinfo

# Demo output. Regenerated by `make demo-static`; a committed copy goes stale the day
# after it is committed and then contradicts the running demo.
out/
demo.json

# Terraform state (never committed: it holds resource ids and sometimes secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Editor / OS
.idea/
.vscode/
.DS_Store
